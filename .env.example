NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose these to the browser.
SUPABASE_SERVICE_ROLE_KEY=
WORKER_API_TOKEN=

# AI copy providers -- at least one is required, whichever the header's
# AI provider switch is set to. Missing the one currently selected causes
# "OPENAI_API_KEY is not configured on the server." / same for Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_COPY_MODEL=
OPENAI_API_KEY=
OPENAI_COPY_MODEL=
# A2: /api/analyze-images (image description + spec OCR). Reuses OPENAI_API_KEY.
OPENAI_VISION_MODEL=gpt-4o-mini

# D4: AI de_text (images/edits) + regenerate (images/generations).
# Reuses OPENAI_API_KEY. Missing key → honest error (no fake images).
# Default model gpt-image-1 supports both generate and edit.
# If you set a non-edit model (e.g. dall-e-3), de_text fails honestly —
# set OPENAI_IMAGE_EDIT_SUPPORTED=false to force-disable edits, or true only
# when the model truly supports POST /v1/images/edits.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_EDIT_SUPPORTED=true


# B8/B19: Web Search for copy evidence + spec pool v2. Server-only.
# Free tier ~1,000 searches/month. Missing key = honest warning, no fake search.
TAVILY_API_KEY=
# tavily (default) | serper (reserved; wire when monthly volume needs it)
WEB_SEARCH_PROVIDER=tavily
# SERPER_API_KEY=

# Shopify publish API is scaffolded in mock-safe mode by default.
# A1 (2026-07-10): Shopify retired "Settings -> Develop apps" custom-app
# tokens on 2026-01-01. Auth is now a Dev Dashboard app's client_credentials
# OAuth grant (no refresh token; src/lib/shopify/adminToken.ts exchanges a
# fresh ~24h token on demand). SHOPIFY_ADMIN_ACCESS_TOKEN is retired -- do not
# resurrect it.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-04
# Optional but recommended for finite stock. If empty, publish will try the
# shop's first active location before sending inventory quantity adjustments.
SHOPIFY_LOCATION_ID=
SHOPIFY_PUBLISH_MOCK=true

# Optional notification webhook for Make / LINE notification flows.
MAKE_WEBHOOK_URL=

# D6: dual-channel batch notify (Email Resend + LINE Messaging API Flex).
# Missing keys → channel skipped (never 500, never fake-send).
# Claim notify_sent_at only when ≥1 channel actually "sent" (Q3b B′).
# ⚠ Do NOT use LINE Notify (shut down 2025-03). Use Messaging API only.
RESEND_API_KEY=
# e.g. Nestory <onboarding@resend.dev> or your verified domain sender
RESEND_FROM=
# Comma-separated whitelist (server-only; not from browser prefs)
NOTIFY_EMAIL_TO=
LINE_CHANNEL_ACCESS_TOKEN=
# Push target user id(s), comma-separated
LINE_USER_ID=
# Deep link base for /review (optional; falls back to https://$VERCEL_URL)
APP_BASE_URL=

# D8a: description embed images (Shopify payload + Matrixify Body HTML).
# Unset / empty = ON (append ≤2 imgs after body text at publish/export boundary).
# Set 0 / false / off to disable (identical to pre-D8a description HTML).
# Never writes images into DB description_html.
# DESCRIPTION_EMBED_IMAGES=
# NESTORY_DESCRIPTION_EMBED_IMAGES=
# Showmore 商品介紹 HTML <img>: default OFF (backend HTML img not verified).
# Set true only after a real Showmore import test.
# SHOWMORE_DESCRIPTION_EMBED_IMAGES=

# C6 + D6: Vercel Cron auth for GET /api/cron/fx and /api/cron/stuck-batches.
# Set the same value in Vercel Project Env; Vercel Cron sends
# Authorization: Bearer $CRON_SECRET on scheduled invokes.
# Local next dev may call the route without a secret (prod/preview reject if unset).
# Free tier: 2 crons — fx (16:00 UTC) + stuck-batches (17:00 UTC).
CRON_SECRET=
