NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose these to the browser.
SUPABASE_SERVICE_ROLE_KEY=
WORKER_API_TOKEN=

# AI copy providers -- at least one is required, whichever the header's
# AI provider switch is set to. Missing the one currently selected causes
# "OPENAI_API_KEY is not configured on the server." / same for Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_COPY_MODEL=
OPENAI_API_KEY=
OPENAI_COPY_MODEL=
# A2: /api/analyze-images (image description + spec OCR). Reuses OPENAI_API_KEY.
OPENAI_VISION_MODEL=gpt-4o-mini

# Shopify publish API is scaffolded in mock-safe mode by default.
# A1 (2026-07-10): Shopify retired "Settings -> Develop apps" custom-app
# tokens on 2026-01-01. Auth is now a Dev Dashboard app's client_credentials
# OAuth grant (no refresh token; src/lib/shopify/adminToken.ts exchanges a
# fresh ~24h token on demand). SHOPIFY_ADMIN_ACCESS_TOKEN is retired -- do not
# resurrect it.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-04
SHOPIFY_PUBLISH_MOCK=true

# Optional notification webhook for Make / LINE notification flows.
MAKE_WEBHOOK_URL=
